<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GPT 娘 · 设置" Width="740" Height="800" MinWidth="620" MinHeight="560" WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Background="Transparent" FontFamily="Microsoft YaHei UI" FontSize="14" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize">
  <Window.Resources>
    <Style TargetType="PasswordBox">
      <Setter Property="Foreground" Value="#493758"/>
      <Setter Property="Background" Value="#FCFAFE"/>
      <Setter Property="BorderBrush" Value="#E2D6EC"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <SolidColorBrush x:Key="Ink" Color="#493758"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#493758"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#917E9E"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,4,0,8"/>
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="BorderBrush" Value="#EDE5F3"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="20"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#75528F"/>
      <Setter Property="Background" Value="#EEE5F7"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Margin" Value="0,3,8,3"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Body" Property="Background" Value="#E3D4F0"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Body" Property="Background" Value="#D7C0E9"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#493758"/>
      <Setter Property="Margin" Value="0,9,0,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <DockPanel LastChildFill="True">
              <Border x:Name="Track" DockPanel.Dock="Right" Width="38" Height="22" CornerRadius="11" Background="#DFD5E6" Margin="20,0,0,0">
                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3"/>
              </Border>
              <ContentPresenter VerticalAlignment="Center"/>
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#A17DBF"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#493758"/>
      <Setter Property="Background" Value="#FCFAFE"/>
      <Setter Property="BorderBrush" Value="#E2D6EC"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="Margin" Value="0,6,0,12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="10"/>
      <Setter Property="Margin" Value="0,6,0,12"/>
      <Setter Property="Background" Value="#FCFAFE"/>
      <Setter Property="BorderBrush" Value="#E2D6EC"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" IsItemsHost="True"/>
              <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,16,0,0" TextElement.FontWeight="Normal"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#8E799E"/>
      <Setter Property="Padding" Value="25,11"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Tab" Background="Transparent" CornerRadius="11" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Tab" Property="Background" Value="#E9DDF4"/>
                <Setter Property="Foreground" Value="#70498C"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Tab" Property="Background" Value="#F0E9F7"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="#75528F"/>
      <Setter Property="Padding" Value="0,8"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
  </Window.Resources>
  <Border Background="#F8F5FC" CornerRadius="22" BorderBrush="#DCD0E8" BorderThickness="1" Margin="8">
    <Grid Margin="28,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,22" x:Name="WindowHeader" Background="Transparent">
        <Button x:Name="CloseSettings" Content="×" DockPanel.Dock="Right" Width="34" Height="34" Padding="0" Margin="0" FontSize="22" ToolTip="关闭"/>
        <TextBlock Text="GPT 娘" FontSize="25" FontWeight="SemiBold"/>
        <TextBlock Text="设置" Foreground="#A18AAE" VerticalAlignment="Center" Margin="14,5,0,0"/>
      </DockPanel>
      <TabControl x:Name="Tabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
        <TabItem Header="音乐">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <DockPanel>
                    <Button x:Name="OpenNetease" Content="打开" DockPanel.Dock="Right"/>
                    <Border Width="40" Height="40" CornerRadius="12" Background="#CE5367" DockPanel.Dock="Left" Margin="0,0,12,0">
                      <TextBlock Text="♪" Foreground="White" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                      <TextBlock Text="网易云音乐" FontWeight="SemiBold" FontSize="16"/>
                      <TextBlock x:Name="NeteaseState" Text="未连接" Style="{StaticResource Caption}"/>
                    </StackPanel>
                  </DockPanel>
                  <CheckBox x:Name="Netease" Content="播放时律动与歌词" Tag="netease"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <DockPanel>
                    <Button x:Name="OpenQQ" Content="打开" DockPanel.Dock="Right"/>
                    <Border Width="40" Height="40" CornerRadius="12" Background="#52A991" DockPanel.Dock="Left" Margin="0,0,12,0">
                      <TextBlock Text="♫" Foreground="White" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                      <TextBlock Text="QQ 音乐" FontWeight="SemiBold" FontSize="16"/>
                      <TextBlock x:Name="QQMusicState" Text="未连接" Style="{StaticResource Caption}"/>
                    </StackPanel>
                  </DockPanel>
                  <CheckBox x:Name="QQMusic" Content="播放时律动与歌词" Tag="qqmusic"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <DockPanel>
                    <Button x:Name="OpenSpotify" Content="打开" DockPanel.Dock="Right"/>
                    <Border Width="40" Height="40" CornerRadius="12" Background="#5C9C73" DockPanel.Dock="Left" Margin="0,0,12,0">
                      <TextBlock Text="≋" Foreground="White" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                      <TextBlock Text="Spotify" FontWeight="SemiBold" FontSize="16"/>
                      <TextBlock x:Name="SpotifyState" Text="未连接" Style="{StaticResource Caption}"/>
                    </StackPanel>
                  </DockPanel>
                  <CheckBox x:Name="Spotify" Content="播放时律动与歌词" Tag="spotify"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <DockPanel>
                    <TextBlock Text="律动" Style="{StaticResource Heading}"/>
                    <Button x:Name="Reconnect" Content="重新连接" HorizontalAlignment="Right"/>
                  </DockPanel>
                  <CheckBox x:Name="FollowMusic" Content="自动跟随"/>
                  <CheckBox x:Name="ManualMusic" Content="手动律动 · 100 BPM"/>
                  <CheckBox x:Name="Lights" Content="迪灯"/>
                  <CheckBox x:Name="Horizontal" Content="左右移动"/>
                  <TextBlock x:Name="MusicState" Foreground="#B55D73"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="用量">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
              <DockPanel Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                  <Button x:Name="AddProvider" Content="＋ 添加厂商"/>
                  <Button x:Name="QueryUsage" Content="刷新用量" Background="#DED0EC"/>
                </StackPanel>
                <TextBlock x:Name="UsageTime" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
              </DockPanel>
              <TextBlock x:Name="ProviderFeedback" Foreground="#B55D73" Margin="0,0,0,8"/>
              <Border Style="{StaticResource Card}" x:Name="ArkCard">
                <StackPanel>
                  <TextBlock Text="Ark" Style="{StaticResource Heading}"/>
                  <TextBlock Text="Coding Plan · 剩余额度" Style="{StaticResource Caption}"/>
                  <TextBlock x:Name="ArkUsage" FontSize="20" LineHeight="34"/>
                  <Button x:Name="EditArk" Content="编辑" HorizontalAlignment="Right"/>
                </StackPanel>
              </Border>
              <StackPanel x:Name="AccountCards"/>
              <Border x:Name="ProviderEditorCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock Text="厂商查询" Style="{StaticResource Heading}"/>
                  <ComboBox x:Name="Provider" DisplayMemberPath="name"/>
                  <TextBlock x:Name="QueryKind" Style="{StaticResource Caption}"/>
                  <CheckBox x:Name="ProviderEnabled" Content="启用查询"/>
                  <TextBlock x:Name="CredentialLabel" Text="密钥环境变量名"/>
                  <StackPanel x:Name="DirectCredential">
                    <PasswordBox x:Name="ApiKey" Padding="10" Margin="0,6,0,8"/>
                    <DockPanel>
                      <Button x:Name="ClearApiKey" Content="清除已保存密钥" DockPanel.Dock="Right"/>
                      <TextBlock x:Name="ApiKeyState" Style="{StaticResource Caption}"/>
                    </DockPanel>
                  </StackPanel>
                  <StackPanel x:Name="ManagementCredential" Visibility="Collapsed">
                    <TextBlock Text="管理密钥（可选，用于 Credit）"/>
                    <PasswordBox x:Name="ManagementKey" Padding="10" Margin="0,6,0,8"/>
                    <DockPanel>
                      <Button x:Name="ClearManagementKey" Content="清除已保存密钥" DockPanel.Dock="Right"/>
                      <TextBlock x:Name="ManagementKeyState" Style="{StaticResource Caption}"/>
                    </DockPanel>
                  </StackPanel>
                  <Expander x:Name="LegacyCredentials" Header="环境变量（可选）" Margin="0,8">
                    <StackPanel>
                      <TextBlock Text="API 密钥变量名"/>
                      <TextBox x:Name="KeyEnv"/>
                      <StackPanel x:Name="LegacyManagementCredential">
                        <TextBlock Text="管理密钥变量名"/>
                        <TextBox x:Name="ManagementKeyEnv"/>
                      </StackPanel>
                    </StackPanel>
                  </Expander>
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="SaveProvider" Content="保存并查询"/>
                    <Button x:Name="CancelProvider" Content="取消"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="本机 token" Style="{StaticResource Heading}"/>
                  <TextBlock Text="现存记录 · 含归档" Style="{StaticResource Caption}"/>
                  <TextBlock x:Name="LocalUsage" Text="尚未查询" LineHeight="24"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="外观与交互">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="形象" Style="{StaticResource Heading}"/>
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="Characters" Content="更换形象"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <StackPanel x:Name="ExistingSettings"/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="台词">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
              <StackPanel x:Name="QuoteSettings"/>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="我的台词" Style="{StaticResource Heading}"/>
                  <TextBlock Text="每行一句 · 每句最多 200 字 · 权重格式：3 | 台词" Style="{StaticResource Caption}"/>
                  <WrapPanel>
                    <Button x:Name="SaveQuotes" Content="保存"/>
                    <Button x:Name="ResetQuotes" Content="恢复内置台词"/>
                  </WrapPanel>
                  <TextBlock x:Name="QuoteFeedback" Foreground="#B55D73" Margin="0,8,0,0"/>
                  <TextBox x:Name="QuoteLines" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Height="280"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
      <TextBlock x:Name="Feedback" Grid.Row="2" Foreground="#B55D73" Margin="0,8,0,0"/>
    </Grid>
  </Border>
</Window>
